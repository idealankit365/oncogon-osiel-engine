# Browser-to-Python connection used by the Next.js workbench.
NEXT_PUBLIC_OSIEL_API_URL=http://localhost:8000

# Safe local demonstration defaults.
OSIEL_DEMO_MODE=true
OSIEL_DATABASE_PATH=backend/data/osiel.db
OSIEL_OBJECT_STORE_PATH=backend/data/objects
OSIEL_CORS_ORIGINS=http://localhost:3000,http://localhost:4173
OSIEL_API_KEY=

# Outbound official APIs are opt-in. Keep false for tests, teaching fixtures and
# offline operation. Before enabling on a shared server, set a contact-bearing
# User-Agent and confirm each provider's current usage policy.
OSIEL_PUBLIC_CONNECTORS_ENABLED=false
OSIEL_PUBLIC_CONNECTOR_TIMEOUT_SECONDS=12
OSIEL_PUBLIC_CONNECTOR_USER_AGENT="Oncogon-OSIEL/0.2 research-use (contact: research-admin@example.edu)"

# Extended scientific sources. Live fetching is disabled until an operator
# approves each current release, copies its direct HTTPS download URL here and
# records the publisher-provided SHA-256. A missing checksum fetches into
# quarantine but cannot become an accepted dataset.
OSIEL_SOURCE_CONNECTORS_ENABLED=false
OSIEL_SOURCE_CONNECTOR_MAX_BYTES=100000000
OSIEL_NCI60_BULK_URL=
OSIEL_NCI60_BULK_SHA256=
OSIEL_COCONUT_BULK_URL=
OSIEL_COCONUT_BULK_SHA256=
OSIEL_NPASS_BULK_URL=
OSIEL_NPASS_BULK_SHA256=
OSIEL_ANPDB_BULK_URL=
OSIEL_ANPDB_BULK_SHA256=
OSIEL_LOTUS_BULK_URL=
OSIEL_LOTUS_BULK_SHA256=
OSIEL_TOX21_BULK_URL=
OSIEL_TOX21_BULK_SHA256=
OSIEL_TOXCAST_BULK_URL=
OSIEL_TOXCAST_BULK_SHA256=

# Chemspace requires a provider-issued key. Keep the documented API path
# operator-configurable so OSIEL never guesses a licensed endpoint contract.
OSIEL_CHEMSPACE_API_BASE_URL=https://api.chem-space.com
OSIEL_CHEMSPACE_SEARCH_PATH=
OSIEL_CHEMSPACE_API_KEY=

# Real AutoDock Vina jobs are opt-in because they consume CPU. The API accepts
# prepared PDBQT files only and runs vina==1.2.7 in a bounded child process.
OSIEL_VINA_ENABLED=false
OSIEL_VINA_MAX_CPU=4
OSIEL_VINA_MAX_TIMEOUT_SECONDS=600
OSIEL_VINA_MAX_RECEPTOR_BYTES=15000000
OSIEL_VINA_MAX_LIGAND_BYTES=3000000

# Optional local scientific copilot. Install Ollama on the workstation, pull the
# named model, then opt in. The model receives only retrieved evidence records,
# must return structured citations, and falls back safely when unavailable.
OSIEL_OLLAMA_ENABLED=false
OSIEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Compose uses this host-bridge value instead of the loopback value above.
OSIEL_OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OSIEL_OLLAMA_MODEL=qwen3:8b
OSIEL_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OSIEL_OLLAMA_TIMEOUT_SECONDS=120

# Controlled Professor AI corpus. Keep disabled on an unauthenticated shared
# deployment. When enabled, approved PDF/TXT/MD files are stored immutably,
# page-chunked, indexed with FTS5 and optionally embedded through Ollama.
OSIEL_PROFESSOR_INGESTION_ENABLED=false
OSIEL_PROFESSOR_MAX_DOCUMENT_BYTES=20000000
OSIEL_PROFESSOR_MAX_PAGES=500
OSIEL_PROFESSOR_MAX_CHUNKS=2000
OSIEL_PROFESSOR_RETRIEVAL_K=8
OSIEL_PROFESSOR_RETENTION_DAYS=180

# Real remote structure search through the public SmallWorld service linked by
# CartBlanche/ZINC. The configured 2025 REALDB map reports >10B indexed entries.
# One seed is sent per job and at most 100 hits are imported for local RDKit work.
OSIEL_ZINC22_ENABLED=false
OSIEL_ZINC22_BASE_URL=https://sw.docking.org
OSIEL_ZINC22_MAP=REALDB-2025-07.smi.anon
OSIEL_ZINC22_TIMEOUT_SECONDS=45
OSIEL_ZINC22_MIN_POLL_SECONDS=5

# Evidence-backed model laboratory. This permits bounded ChEMBL activity
# retrieval, immutable snapshot creation, scaffold-separated baseline training,
# calibration evaluation and active-learning proposals. It does not promote a
# model automatically and remains separate from the 10B structural-search map.
OSIEL_MODEL_LAB_ENABLED=true
OSIEL_MODEL_LAB_MAX_RECORDS=2000
OSIEL_MODEL_LAB_MAX_CANDIDATES=500

# Fail-closed multimodal specialist-model gateway. Remote services require
# HTTPS; loopback HTTP is allowed for local development only.
OSIEL_MULTIMODAL_ENABLED=false
OSIEL_MULTIMODAL_TIMEOUT_SECONDS=90
OSIEL_MULTIMODAL_MAX_RESPONSE_BYTES=1000000
OSIEL_CHEM_MODEL_URL=
OSIEL_CHEM_MODEL_NAME=chemprop-dmpnn
OSIEL_PROTEIN_MODEL_URL=
OSIEL_PROTEIN_MODEL_NAME=esm
OSIEL_VISION_MODEL_URL=
OSIEL_VISION_MODEL_NAME=cellprofiler-adapter
OSIEL_MULTIMODAL_API_TOKEN=
