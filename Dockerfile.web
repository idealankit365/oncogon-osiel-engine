FROM node:22.13.1-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_OSIEL_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_OSIEL_API_URL=${NEXT_PUBLIC_OSIEL_API_URL}
RUN npm run build

FROM node:22.13.1-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
